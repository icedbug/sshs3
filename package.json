{
  "name": "sshs3",
  "version": "0.97.4",
  "description": "Modern cross-platform SSH, SFTP, and S3 client with smartcard and drag-and-drop support",
  "main": "dist-electron/desktopEntry.js",
  "type": "module",
  "author": {
    "name": "Andreas Lundqvist",
    "email": "info@sshs3.com"
  },
  "license": "MIT",
  "homepage": "https://unixkonsult.se/sshs3",
  "desktopName": "sshs3",
  "repository": {
    "type": "git",
    "url": "https://github.com/alun-hub/sshs3.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:prod": "npm run build && electron --no-sandbox .",
    "demo": "npm run build && electron --no-sandbox . --demo",
    "build": "tsc --noEmit && vite build",
    "build:web": "node scripts/build-web.mjs",
    "start:web": "node dist-web/server.mjs",
    "deploy:vm": "bash ./scripts/deploy-vm.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux",
    "package:appimage": "npm run build && electron-builder --linux AppImage",
    "package:win": "npm run build && electron-builder --win",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:lint": "node scripts/docs-lint.mjs",
    "deploy": "./scripts/deploy.sh",
    "copr": "./scripts/copr-build.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sso": "^3.1149.0",
    "@aws-sdk/client-sso-oidc": "^3.1149.0",
    "@aws-sdk/credential-provider-sso": "^3.973.16",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@kubernetes/client-node": "^2.0.1",
    "@lezer/highlight": "^1.2.5",
    "@orama/orama": "^3.1.18",
    "@tanstack/react-virtual": "^3.14.21",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.59.0",
    "node-pty": "^1.1.0",
    "pkcs11js": "^2.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "safe-regex2": "^5.1.2",
    "win-ca": "^3.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true,
    "pkcs11js@2.1.7": true,
    "win-ca@3.5.1": true
  }
}
