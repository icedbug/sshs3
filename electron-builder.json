{
  "appId": "com.sshs3.app",
  "productName": "sshs3",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "build/icon.png",
    "package.json"
  ],
  "icon": "build/icon.png",
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "ai-hub-icon.png"
    }
  ],
  "linux": {
    "target": [
      "AppImage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "icon": "build/icons",
    "synopsis": "Modern SSH, SFTP, and S3 client with smartcard and drag-and-drop support",
    "extraResources": [
      {
        "from": "build-resources/age/linux",
        "to": "age",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      "nsis",
      "portable",
      "zip",
      "msi"
    ],
    "artifactName": "${name}-${version}.${ext}",
    "extraResources": [
      {
        "from": "build-resources/vcxsrv",
        "to": "vcxsrv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/age/win",
        "to": "age",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libasound2t64 | libasound2",
      "libgbm1"
    ]
  },
  "rpm": {
    "depends": [
      "gtk3",
      "libnotify",
      "nss",
      "libXScrnSaver",
      "(libXtst or libXtst6)",
      "xdg-utils",
      "at-spi2-core",
      "(libuuid or libuuid1)",
      "(alsa-lib or libasound2)",
      "(mesa-libgbm or libgbm1)"
    ],
    "afterRemove": "build/linux/rpm-after-remove.sh",
    "fpm": [
      "--rpm-posttrans",
      "build/linux/rpm-posttrans.sh"
    ]
  },
  "msi": {
    "oneClick": true,
    "perMachine": true,
    "upgradeCode": "E2342C4F-1463-4420-BB6B-CA3BDB735CB3",
    "runAfterFinish": false,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${name}-Setup-${version}.${ext}",
    "include": "build/installer.nsh"
  },
  "portable": {
    "artifactName": "${name}-${version}-portable.${ext}",
    "splashImage": "build/portable-splash.bmp"
  },
  "publish": {
    "provider": "github",
    "owner": "alun-hub",
    "repo": "sshs3"
  },
  "electronFuses": {
    "runAsNode": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "onlyLoadAppFromAsar": true
  }
}
